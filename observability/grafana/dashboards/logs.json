{
  "uid": "aurora-logs",
  "title": "Aurora | Log tập trung",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Nginx access log",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{project=\"aurora-de3\",service=\"nginx\",stream=\"access\"} | json",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 2,
      "title": "HTTP lỗi",
      "type": "logs",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{project=\"aurora-de3\",service=\"nginx\",stream=\"access\"} | json | status >= 400",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 3,
      "title": "Ứng dụng WordPress",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{project=\"aurora-de3\",service=\"wordpress\",stream=\"events\"} | json",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 4,
      "title": "Đăng nhập thất bại",
      "type": "logs",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{project=\"aurora-de3\",service=\"wordpress\",stream=\"events\"} | json | event=\"login_failed\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    }
  ]
}
